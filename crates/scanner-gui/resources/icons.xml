<?xml version="1.0" encoding="UTF-8"?>
<!-- Иконки кладутся ПРЯМО в корень ресурсного пути: GTK 4.10+ трактует
     файлы в зарегистрированном resource-path как «unthemed» иконки
     (gtkicontheme.c: g_resources_enumerate_children без обхода подкаталогов).

     PNG-версии — запасной путь для минимальных систем, где pixbuf не умеет
     SVG: PNG рендерится GDK напрямую. На обычных столах используется тема. -->
